# Copy to .env and adjust. Used by docker-compose.yml.

# Folder on the HOST where all data (SQLite + Markdown) is stored.
TRAVELSTEPS_DATA_DIR=/share/travelsteps

# Port on the host. Point your Cloudflare Tunnel to http://<host-ip>:<PORT>.
PORT=8080

# First admin account. Only used when the database has no users yet (first start, or after
# deleting travelsteps.db). Password: at least 12 characters; you must change it at first login.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Public URL as reached through Cloudflare. Used as contact address in Web Push messages.
PUBLIC_URL=https://blog.example.com

# Session cookies are only sent over HTTPS when true (keep true behind Cloudflare).
# Set to false ONLY when testing over plain http on your LAN (e.g. http://192.168.1.10:8080).
COOKIE_SECURE=true

# Use the CF-Connecting-IP header for rate limiting (true when behind Cloudflare Tunnel).
# Only trusted when the connection comes from localhost or a private network (where
# cloudflared runs); direct connections from the internet cannot spoof it.
TRUST_CLOUDFLARE=true

# Session lifetime in days (sliding).
SESSION_TTL_DAYS=30

# Optional: at least 32 characters. When empty a random secret is generated
# and stored in the data folder (.session-secret).
SESSION_SECRET=

# Immich (photos; every traveller sets an own API key in Profiel) and OpenRouteService
# (routing, optional: without a key routes are straight lines).
IMMICH_URL=
ORS_API_KEY=
# ORS_URL=https://api.openrouteservice.org

LOG_LEVEL=info
# Nightly database backups (after 03:00) in <DATA_DIR>/backups; the newest N are kept, 0 = off.
BACKUP_KEEP=7
TZ=Europe/Amsterdam
